# Copy to .env for local `npm run dev`
BFF_PORT=3001

# Must match the Spine API admin key (same as ADMIN_API_KEY in repo root .env)
SPINE_ADMIN_API_KEY=change-me

# Where the FastAPI app listens (use http://127.0.0.1:8000 when API runs via docker compose mapped port)
SPINE_BASE_URL=http://127.0.0.1:8000

# Session secret for express-session
SESSION_SECRET=change-me-long-random-string

# Comma-separated emails that may use Organizations (platform admin) in the dashboard
# BFF_PLATFORM_ADMIN_EMAILS=you@example.com
